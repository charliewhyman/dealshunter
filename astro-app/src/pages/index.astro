---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { ProductGrid } from '@/components/ProductGrid';
import { sql } from '@/lib/db';

const featured = await sql`
  SELECT
    id, title, handle, shop_id, shop_name,
    min_price, max_discount_percentage, on_sale, in_stock,
    images, top_level_category, subcategory, grouped_product_type
  FROM products_with_details_core
  WHERE in_stock = true
    AND is_archived = false
    AND max_discount_percentage > 20
  ORDER BY max_discount_percentage DESC NULLS LAST, id
  LIMIT 40
`;

const canonical = new URL('/', Astro.site);
---

<Layout
  title="Curated Canada – Canadian Independent Brand Deals"
  description="Compare deals on clothing, footwear, accessories, and home goods from independent Canadian brands. Prices updated daily."
  canonical={canonical}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-3xl font-bold mb-2">Deals from Canadian Independent Brands</h1>
    <p class="text-gray-600 mb-8">Top discounts, updated daily.</p>
    <ProductGrid client:visible products={featured} />
  </main>
</Layout>