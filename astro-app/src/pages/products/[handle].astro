---
import Layout from '@/layouts/Layout.astro';
import { sql } from '@/lib/db';

export const prerender = false;

const { handle } = Astro.params;
if (!handle) return Astro.redirect('/404');

const [product] = await sql`
  SELECT * FROM products_with_details_core WHERE handle = ${handle} LIMIT 1
`;
if (!product) return Astro.redirect('/404');

const variants = await sql`
  SELECT id, title, price, compare_at_price, available, size
  FROM variants WHERE product_id = ${product.id}
  ORDER BY sort_order_1 NULLS LAST, sort_order_2 NULLS LAST
`;

const availableVariants = variants.filter((v: any) => v.available);
const firstAvailable = availableVariants[0] ?? variants[0];

const variantPrice: number | null = firstAvailable?.price != null
  ? Number(firstAvailable.price)
  : product.min_price != null ? Number(product.min_price) : null;

const compareAtPrice: number | null = firstAvailable?.compare_at_price != null
  ? Number(firstAvailable.compare_at_price) : null;

const discountPercentage = compareAtPrice && variantPrice && compareAtPrice > variantPrice
  ? Math.round(((compareAtPrice - variantPrice) / compareAtPrice) * 100)
  : product.max_discount_percentage != null
    ? Math.round(Number(product.max_discount_percentage)) : 0;

const allUnavailable = variants.length > 0 && variants.every((v: any) => !v.available);
const isAvailable = Boolean(product.in_stock) && !allUnavailable;

const imagesArray: Array<{ src: string; alt?: string }> = Array.isArray(product.images) ? product.images : [];
const firstImage = imagesArray[0];

const rawDescription = product.description ? String(product.description) : '';
const isHtmlDescription = /<[a-z][\s\S]*>/i.test(rawDescription);

const productTitle = product.title ?? 'Untitled Product';
const shopName = product.shop_name ?? 'Canadian Brand';
const title = `${productTitle} – ${shopName} | Curated Canada`;
const description = rawDescription
  ? rawDescription.replace(/<[^>]+>/g, '').slice(0, 155).replace(/\s+/g, ' ').trim()
  : `${productTitle} from ${shopName}.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<Layout title={title} description={description} canonical={canonical} noindex={true}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-8">
    <div class="flex flex-col lg:flex-row gap-6 sm:gap-8">
      <div class="w-full lg:w-1/2 xl:w-2/5">
        <div class="sticky top-4">
          {firstImage ? (
            <img
              src={firstImage.src}
              alt={firstImage.alt ?? productTitle}
              class="w-full h-auto max-h-[70vh] object-contain rounded-lg shadow-md"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="w-full h-[400px] bg-gray-100 dark:bg-gray-800 rounded-lg flex items-center justify-center">
              <span class="text-gray-400">No Image Available</span>
            </div>
          )}
        </div>
      </div>

      <div class="w-full lg:w-1/2 xl:w-3/5 space-y-4 sm:space-y-6">
        {product.shop_name && (
          <p class="text-sm text-gray-500 uppercase tracking-wider">{product.shop_name}</p>
        )}

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">{productTitle}</h1>

        {!isAvailable && (
          <div class="inline-block px-3 py-1.5 bg-red-100 text-red-800 text-sm font-medium rounded-md">
            {!product.in_stock ? 'Out of Stock' : 'Currently Unavailable'}
          </div>
        )}

        {variantPrice !== null && (
          <div class="flex items-baseline gap-3 flex-wrap">
            <span class="text-3xl sm:text-4xl font-bold">${variantPrice.toFixed(2)}</span>
            {compareAtPrice && compareAtPrice > variantPrice && (
              <>
                <span class="text-xl text-gray-500 line-through">${compareAtPrice.toFixed(2)}</span>
                <span class="px-2.5 py-1 bg-red-600 text-white text-sm font-bold rounded">
                  Save {discountPercentage}%
                </span>
              </>
            )}
          </div>
        )}

        {variants.length > 0 && variants.some((v: any) => v.title !== 'Default Title') && (
          <div class="space-y-3">
            <h3 class="text-sm font-semibold uppercase tracking-wide">Available Options</h3>
            <div class="flex flex-wrap gap-2">
              {variants.map((v: any) =>
                v.title !== 'Default Title' ? (
                  <span class={v.available
                    ? 'text-sm px-4 py-2 rounded-md border border-gray-300'
                    : 'text-sm px-4 py-2 rounded-md border border-gray-200 text-gray-400 line-through'}>
                    {v.title}{!v.available && ' (Unavailable)'}
                  </span>
                ) : null
              )}
            </div>
          </div>
        )}

        <div class="pt-2">
          <a href={`/api/out/${product.id}?src=page`} target="_blank" rel="noopener noreferrer"
            class={isAvailable
              ? 'inline-flex items-center justify-center gap-2 w-full px-6 py-4 text-base sm:text-lg font-semibold rounded-lg bg-blue-600 text-white hover:bg-blue-700'
              : 'inline-flex items-center justify-center gap-2 w-full px-6 py-4 text-base sm:text-lg font-semibold rounded-lg bg-gray-200 text-gray-500 cursor-not-allowed'}>
            {isAvailable ? 'View on Store' : 'Currently Unavailable'}
          </a>
        </div>

        {rawDescription ? (
          <div class="pt-6 border-t border-gray-200">
            <h2 class="text-xl font-semibold mb-4">Product Description</h2>
            {isHtmlDescription ? (
              <div class="text-gray-700 description-html" set:html={rawDescription} />
            ) : (
              <div class="text-gray-700 whitespace-pre-line">{rawDescription}</div>
            )}
          </div>
        ) : (
          <div class="pt-6 border-t border-gray-200">
            <h2 class="text-xl font-semibold mb-4">Product Description</h2>
            <p class="text-gray-500 italic">No description available.</p>
          </div>
        )}

        <div class="pt-6 border-t border-gray-200 space-y-3 text-sm">
          {product.grouped_product_type && (
            <div class="flex gap-2">
              <span class="font-medium min-w-24">Category:</span>
              <span class="text-gray-600">{product.grouped_product_type}</span>
            </div>
          )}
          {product.shop_name && (
            <div class="flex gap-2">
              <span class="font-medium min-w-24">Store:</span>
              <span class="text-gray-600">{product.shop_name}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </main>
</Layout>