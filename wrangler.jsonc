{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealshunter-astro",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "curatedcanada.ca",
      "custom_domain": true
    }
  ],

  "vars": {
    "ALERT_FROM_EMAIL": "deals@curatedcanada.ca",
    "ALERT_SITE_URL": "https://curatedcanada.ca",
  },

  "kv_namespaces": [
    { 
      "binding": "SESSION", 
      "id": "24971d4293b64f2999af6c0faf7fa9db",
      "preview_id": "4dbf9ab3da7a44738d5aa27d664138e8"
    }
  ]
}