{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealshunter-astro",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "curatedcanada.ca",
      "custom_domain": true
    }
  ],

  "vars": {
    "ALERT_FROM_EMAIL": "deals@curatedcanada.ca",
    "ALERT_SITE_URL": "https://curatedcanada.ca",
    "ALERT_TEST_RECIPIENTS": "charliewhyman@proton.me",
    "LIVE_SEND_ENABLED": "false"
  },

  "kv_namespaces": [
    { "binding": "SESSION", "id": "24971d4293b64f2999af6c0faf7fa9db" }
  ]
}